+
+## 6) کد مرجع کامل — سمت کلاینت (صفحه‌ی چک‌اوت)
+
+این کد، نسخه‌ی کامل و تست‌شده‌ی `checkout.html` است (بخش‌های غیرمرتبط با منطق پرداخت مثل استایل حذف شده‌اند؛ نسخه‌ی کامل با استایل در فایل `web/checkout.html` همین ریپو موجود است):
+
+```html
+<script src="https://sdk.minepi.com/pi-sdk.js"></script>
+<script>
+(function () {
+  "use strict";
+
+  const BACKEND_URL = "https://your-backend.example.com"; // آدرس بک‌اند شما
+  const BACKEND_ANON_KEY = "..."; // کلید عمومی احراز هویت به بک‌اند (نه Server API Key پای!)
+  const PI_SANDBOX = false; // طبق بخش ۲ تنظیم کنید
+
+  const params = new URLSearchParams(window.location.search);
+  const token = params.get("token"); // همان sessionToken که در مرحله‌ی ۰ ساخته شد
+
+  async function postFunction(name, body) {
+    const response = await fetch(BACKEND_URL + "/" + name, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", /* هدرهای احراز هویت بک‌اند خودتان */ },
+      body: JSON.stringify(body)
+    });
+    const data = await response.json().catch(() => ({}));
+    if (!response.ok) throw new Error(data.error || "HTTP " + response.status);
+    return data;
+  }
+
+  // --- بازیابی پرداخت ناقص: تابعی مستقل، چون ممکن است از چند جا صدا زده شود ---
+  async function recoverIncompletePayment(payment, accessToken) {
+    if (!payment || !payment.identifier) return false;
+    const transactionId = payment.transaction && payment.transaction.txid;
+    if (!transactionId) {
+      // پرداخت امضا شده ولی هنوز روی بلاک‌چین ثبت نشده — چیزی برای complete کردن نیست، صبر کنید
+      return true;
+    }
+    await postFunction("pi-complete", {
+      paymentId: payment.identifier,
+      txId: transactionId,
+      sessionToken: token,
+      accessToken: accessToken
+    });
+    return true;
+  }
+
+  async function startPayment(session) {
+    if (!window.Pi) throw new Error("Pi Browser SDK is unavailable.");
+    await Pi.init({ version: "2.0", sandbox: PI_SANDBOX });
+
+    let incompletePayment = null;
+    let accessTokenRef = null;
+    let recoveryPromise = null;
+
+    // *** نکته‌ی حیاتی (خطای #۵ در بخش ۹) ***
+    // Pi می‌تواند این کال‌بک را هم حین authenticate و هم دیرتر، حین createPayment، صدا بزند.
+    // بنابراین همین‌جا هم بازیابی را شروع می‌کنیم (اگر accessToken آماده باشد)، نه فقط یک بار بعد از authenticate.
+    function waitForIncompletePayment(timeoutMs) {
+      return new Promise(function (resolve) {
+        const start = Date.now();
+        (function poll() {
+          if (incompletePayment || Date.now() - start >= timeoutMs) return resolve();
+          setTimeout(poll, 250);
+        })();
+      });
+    }
+
+    const auth = await Pi.authenticate(
+      ["username", "payments"],
+      function (payment) {
+        incompletePayment = payment || null;
+        if (accessTokenRef && incompletePayment && !recoveryPromise) {
+          recoveryPromise = recoverIncompletePayment(incompletePayment, accessTokenRef);
+        }
+      }
+    );
+
+    if (!auth || !auth.accessToken) throw new Error("Pi authentication was not completed.");
+    accessTokenRef = auth.accessToken;
+
+    if (incompletePayment && incompletePayment.identifier) {
+      await (recoveryPromise || recoverIncompletePayment(incompletePayment, auth.accessToken));
+      return;
+    }
+
+    const paymentPromise = Pi.createPayment(
+      {
+        amount: Number(session.amountPi),
+        memo: "توضیح پرداخت",
+        metadata: { sessionToken: token }
+      },
+      {
+        onReadyForServerApproval: async function (paymentId) {
+          await postFunction("pi-approve", { paymentId, sessionToken: token, accessToken: auth.accessToken });
+        },
+        onReadyForServerCompletion: async function (paymentId, txid) {
+          await postFunction("pi-complete", { paymentId, txId: txid, sessionToken: token, accessToken: auth.accessToken });
+        },
+        onCancel: function (paymentId) {
+          postFunction("pi-cancel", { paymentId, sessionToken: token, accessToken: auth.accessToken }).catch(function () {});
+        },
+        onError: function (error) {
+          // ممکن است این خطا دقیقاً به این دلیل باشد که یک پرداخت ناقص قدیمی جلوی پرداخت جدید را گرفته
+          // ولی کال‌بک آن هنوز نرسیده — کمی صبر کنید، شاید برسد.
+          (recoveryPromise || waitForIncompletePayment(3000).then(function () {
+            if (incompletePayment && incompletePayment.identifier) {
+              return recoverIncompletePayment(incompletePayment, accessTokenRef);
+            }
+            throw new Error("Pi payment could not be started.");
+          }));
+        }
+      }
+    );
+
+    // تایم‌اوت ایمنی، نه محدودکننده‌ی جریان طبیعی — پنجره‌ی واقعی Pi می‌تواند بیش از یک دقیقه باشد
+    await Promise.race([
+      paymentPromise,
+      new Promise((_, reject) => setTimeout(() => reject(new Error("timeout")), 180000))
+    ]);
+  }
+})();
+</script>
+```
