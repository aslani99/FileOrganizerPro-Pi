+## 7) کد مرجع کامل — سمت سرور (Edge Functions)
+
+> این کد به زبان Deno/TypeScript (Supabase Edge Functions) است؛ منطق را عیناً به زبان بک‌اند خودتان (Node.js، Python، و غیره) پیاده کنید — چیزی که مهم است **ترتیب چک‌ها و اعتبارسنجی‌ها**ست، نه خود زبان.
+
+### فایل مشترک (`_shared/helpers.ts`)
+```ts
+export const PI_PLATFORM_API_BASE = "https://api.minepi.com/v2"; // برای Testnet و Mainnet یکی است؛ تفاوت فقط در وضعیت خود اپ است
+
+export async function getPiUserFromAccessToken(accessToken: string) {
+  const resp = await fetch(`${PI_PLATFORM_API_BASE}/me`, {
+    headers: { Authorization: `Bearer ${accessToken}` },
+  });
+  if (!resp.ok) return null;
+  const data = await resp.json();
+  return data?.uid ?? data?.user?.uid ?? null;
+}
+
+export async function getPiPayment(paymentId: string) {
+  const piKey = Deno.env.get("PI_SERVER_API_KEY")!;
+  const resp = await fetch(`${PI_PLATFORM_API_BASE}/payments/${paymentId}`, {
+    headers: { Authorization: `Key ${piKey}` },
+  });
+  if (!resp.ok) return null;
+  return await resp.json();
+}
+
+export const PAYMENT_SESSION_TTL_MS = 30 * 60 * 1000; // فقط برای ساخت/تأیید اولیه، نه برای رد کردن تکمیلِ یک پرداخت واقعاً انجام‌شده (خطای #۳)
+export function isPaymentSessionExpired(createdAt) {
+  return Date.now() - Date.parse(createdAt) > PAYMENT_SESSION_TTL_MS;
+}
+```
+
+### `create-payment-session`
+```ts
+// کاربر را از توکن احراز هویت تشخیص می‌دهد، مبلغ پلن را از دیتابیس می‌خواند (نه از کلاینت)،
+// یک ردیف payment_sessions با وضعیت pending می‌سازد، و لینک چک‌اوت را برمی‌گرداند.
+Deno.serve(async (req) => {
+  const user = await getUserFromRequest(req);
+  if (!user) return jsonResponse({ error: "unauthorized" }, 401);
+
+  const { plan } = await req.json();
+  const planRow = await getPlan(plan); // از دیتابیس، نه هاردکد
+  if (!planRow) return jsonResponse({ error: "invalid plan" }, 400);
+
+  const { data } = await serviceClient()
+    .from("payment_sessions")
+    .insert({ user_id: user.id, requested_plan: plan, amount_pi: planRow.pi_amount })
+    .select("token").single();
+
+  const checkoutUrl = `https://yourdomain.com/checkout.html?token=${data.token}&plan=${plan}&amount=${planRow.pi_amount}`;
+  return jsonResponse({ token: data.token, checkoutUrl, amountPi: planRow.pi_amount });
+});
+```
+
+### `pi-approve`
+```ts
+Deno.serve(async (req) => {
+  const { sessionToken, paymentId } = await req.json();
+  const piAccessToken = body.accessToken;
+  if (!sessionToken || !paymentId || !piAccessToken) return jsonResponse({ error: "missing parameter" }, 400);
+
+  const piUserUid = await getPiUserFromAccessToken(piAccessToken);
+  if (!piUserUid) return jsonResponse({ error: "invalid Pi auth" }, 401);
+
+  const client = serviceClient();
+  const { data: session } = await client.from("payment_sessions").select("*").eq("token", sessionToken).single();
+  if (!session) return jsonResponse({ error: "session not found" }, 404);
+  if (isPaymentSessionExpired(session.created_at)) return jsonResponse({ error: "session expired" }, 410);
+  if (session.status === "completed") return jsonResponse({ ok: true, alreadyCompleted: true });
+  if (!["pending", "approved"].includes(session.status)) return jsonResponse({ error: "session not payable" }, 409);
+  if (session.pi_user_uid && session.pi_user_uid !== piUserUid) return jsonResponse({ error: "user mismatch" }, 403);
+
+  // *** هرگز به amount/user کلاینت اعتماد نکنید — دوباره از خود Pi بگیرید ***
+  const piPayment = await getPiPayment(paymentId);
+  if (!piPayment) return jsonResponse({ error: "could not load payment from Pi" }, 502);
+  if (piPayment.user_uid !== piUserUid) return jsonResponse({ error: "payment user mismatch" }, 403);
+  if (piPayment.direction !== "user_to_app") return jsonResponse({ error: "invalid direction" }, 400);
+  if (Number(piPayment.amount) !== Number(session.amount_pi)) return jsonResponse({ error: "amount mismatch" }, 400);
+  if (piPayment.metadata?.sessionToken !== sessionToken) return jsonResponse({ error: "session metadata mismatch" }, 400);
+
+  const piKey = Deno.env.get("PI_SERVER_API_KEY")!;
+  const resp = await fetch(`${PI_PLATFORM_API_BASE}/payments/${paymentId}/approve`, {
+    method: "POST",
+    headers: { Authorization: `Key ${piKey}` },
+  });
+  if (!resp.ok) return jsonResponse({ error: "Pi approve failed" }, 502); // status را pending نگه دارید تا SDK دوباره تلاش کند
+
+  await client.from("payment_sessions")
+    .update({ pi_payment_id: paymentId, pi_user_uid: piUserUid, status: "approved" })
+    .eq("token", sessionToken).neq("status", "completed");
+
+  return jsonResponse({ ok: true });
+});
+```
+
+### `pi-complete` — نسخه‌ی نهایی و اصلاح‌شده (شامل تمام فیکس‌های بخش ۹)
+```ts
+Deno.serve(async (req) => {
+  const body = await req.json().catch(() => ({}));
+  const { paymentId, txId, accessToken } = body;
+  let sessionToken = body.sessionToken;
+  if (!paymentId || !txId) return jsonResponse({ error: "missing parameter" }, 400);
+
+  const client = serviceClient();
+
+  // accessToken ممکن است نباشد (مسیر بازیابی پرداخت ناقص قبل از رسیدن accessToken)
+  let piUserUid: string | null = null;
+  if (accessToken) {
+    piUserUid = await getPiUserFromAccessToken(accessToken);
+    if (!piUserUid) return jsonResponse({ error: "invalid Pi auth" }, 401);
+  }
+
+  // *** فیکس خطای #۲: جزئیات را اول از Pi بگیرید، بعد sessionToken را از metadata خودِ پرداخت
+  // بردارید — نه از چیزی که کلاینت همین الان فرستاده. یک پرداخت ناقص قدیمی به یک جلسه‌ی
+  // قدیمی تعلق دارد، نه به جلسه‌ی تازه‌ای که الان باز است. ***
+  const piPayment = await getPiPayment(paymentId);
+  if (!piPayment) return jsonResponse({ error: "could not load payment from Pi" }, 502);
+  if (piPayment.metadata?.sessionToken) sessionToken = piPayment.metadata.sessionToken;
+  if (!sessionToken) return jsonResponse({ error: "no session token resolvable" }, 400);
+
+  const { data: session } = await client.from("payment_sessions").select("*").eq("token", sessionToken).single();
+  if (!session) return jsonResponse({ error: "session not found" }, 404);
+  if (session.status === "completed") return jsonResponse({ ok: true, alreadyCompleted: true });
+  if (!["approved", "pending"].includes(session.status)) return jsonResponse({ error: "session not completable" }, 409);
+
+  // *** فیکس خطای #۳: TTL جلسه فقط برای جلوگیری از approve های رهاشده است؛ یک پرداخت که
+  // از خود Pi با Server API Key تأیید شده، حتی اگر جلسه‌اش "منقضی" شمرده شود، باید نهایی شود. ***
+  // (فقط لاگ هشدار — رد نکنید)
+
+  if (session.pi_payment_id && session.pi_payment_id !== paymentId) return jsonResponse({ error: "payment id mismatch" }, 400);
+
+  if (!piUserUid) {
+    piUserUid = piPayment.user_uid ?? null;
+    if (!piUserUid) return jsonResponse({ error: "no Pi user uid available" }, 403);
+  }
+  if (session.pi_user_uid && session.pi_user_uid !== piUserUid) return jsonResponse({ error: "user mismatch" }, 403);
+  if (piPayment.user_uid !== piUserUid) return jsonResponse({ error: "payment user mismatch" }, 403);
+  if (Number(piPayment.amount) !== Number(session.amount_pi)) return jsonResponse({ error: "amount mismatch" }, 400);
+  if (piPayment.direction !== "user_to_app") return jsonResponse({ error: "invalid direction" }, 400);
+  if (piPayment.transaction?.txid && piPayment.transaction.txid !== txId) return jsonResponse({ error: "txid mismatch" }, 400);
+  if (piPayment.transaction?.verified === false) return jsonResponse({ error: "transaction not yet verified" }, 409);
+
+  const piKey = Deno.env.get("PI_SERVER_API_KEY")!;
+  let confirmed = piPayment.status?.developer_completed === true;
+  if (!confirmed) {
+    const resp = await fetch(`${PI_PLATFORM_API_BASE}/payments/${paymentId}/complete`, {
+      method: "POST",
+      headers: { Authorization: `Key ${piKey}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ txid: txId }),
+    });
+    if (!resp.ok) return jsonResponse({ error: "Pi complete failed" }, 502);
+    confirmed = true;
+  }
+
+  const { data: updatedSession } = await client.from("payment_sessions")
+    .update({ status: "completed", tx_id: txId, pi_user_uid: piUserUid, pi_payment_id: paymentId })
+    .eq("token", sessionToken).neq("status", "completed")
+    .select().maybeSingle();
+
+  if (!updatedSession) return jsonResponse({ ok: true, alreadyCompleted: true });
+
+  // اینجا محصول/اشتراک واقعی را برای session.user_id فعال کنید (خارج از اسکوپ این سند — منطق کسب‌وکار شماست)
+
+  return jsonResponse({ ok: true });
+});
+```
+
+### `pi-cancel`
+```ts
+Deno.serve(async (req) => {
+  const { sessionToken, paymentId, accessToken } = await req.json();
+  if (!sessionToken || !accessToken) return jsonResponse({ error: "missing parameter" }, 400);
+  const piUserUid = await getPiUserFromAccessToken(accessToken);
+  if (!piUserUid) return jsonResponse({ error: "invalid Pi auth" }, 401);
+
+  const client = serviceClient();
+  const { data: session } = await client.from("payment_sessions").select("*").eq("token", sessionToken).single();
+  if (!session) return jsonResponse({ error: "session not found" }, 404);
+  if (session.status === "completed") return jsonResponse({ ok: true, alreadyCompleted: true });
+
+  // توصیه‌شده (در نسخه‌ی فعلی این پروژه هنوز اضافه نشده — به بخش ۹، خطای #۸ نگاه کنید):
+  // if (paymentId) {
+  //   const piKey = Deno.env.get("PI_SERVER_API_KEY")!;
+  //   await fetch(`${PI_PLATFORM_API_BASE}/payments/${paymentId}/cancel`, {
+  //     method: "POST", headers: { Authorization: `Key ${piKey}` },
+  //   });
+  // }
+
+  await client.from("payment_sessions")
+    .update({ status: "cancelled", pi_payment_id: paymentId ?? session.pi_payment_id, pi_user_uid: piUserUid })
